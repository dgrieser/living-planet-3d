{
  "name": "living-planet-3d",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "license": "0BSD",
  "description": "Educational, bilingual (EN/DE) interactive 3D astronomy simulations built with Vite and Three.js.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "check:i18n": "node scripts/check-i18n.mjs",
    "check:prefs": "node scripts/check-prefs.mjs",
    "check:axial": "node scripts/check-axial-tilt-physics.mjs && node scripts/check-axial-tilt-climate.mjs",
    "check:orbits": "node scripts/check-orbits.mjs",
    "check:hz": "node scripts/check-habitable-zone.mjs",
    "check:tides": "node scripts/check-moon-tides.mjs",
    "check:mag": "node scripts/check-magnetosphere.mjs",
    "check:galaxy": "node scripts/check-galactic-zone.mjs"
  },
  "dependencies": {
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.9.1",
    "globals": "^17.11.0",
    "vite": "^8.2.2"
  }
}
